      <column caption='Drought Segment' datatype='string' name='[Calculation_1801887638204416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PDSI] &gt; 0 THEN &quot;Normal to Moist&quot; &#13;&#10;ELSE &quot;Drought&quot;&#13;&#10;END' />
